rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      // Anyone signed in (anonymously) can see a room. Only its host can create or change it.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid;

      // Each player writes only their own entry.
      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Orders can only be sent as yourself, and can never be edited or deleted.
      match /actions/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      }

      // Messages are sent as yourself. Private messages are readable only by sender and recipient.
      match /chat/{id} {
        allow read: if request.auth != null && (
          resource.data.to == 'all' ||
          resource.data.to == request.auth.uid ||
          resource.data.from == request.auth.uid);
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 280;
      }
    }
  }
}
